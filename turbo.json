{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#graph:generate": {
      "inputs": [
        "content/**",
        "packages/content/**",
        "packages/graph/**",
        "packages/domain/**",
        "scripts/generate-graph.ts"
      ],
      "outputs": [".cache/knowledge-map.json"]
    },
    "build": {
      "dependsOn": ["^build", "//#graph:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    }
  }
}
