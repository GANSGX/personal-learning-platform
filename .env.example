# Copy to `.env.local` — never commit real values.
# See CONTRIBUTING.md and docs/adr/0002-supabase-cloud-progress-auth.md

# Supabase (public in browser bundle — RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server / CI only — NEVER expose to client or commit real value
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dev only: allow IndexedDB progress when not logged in (default false in production)
# NEXT_PUBLIC_ALLOW_LOCAL_PROGRESS=true
