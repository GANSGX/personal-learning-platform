{
  "name": "@plp/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm -w graph:generate",
    "prebuild": "pnpm -w graph:generate",
    "prestart": "pnpm -w graph:generate",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --project=chromium",
    "e2e:all": "playwright test --project=chromium --project=webkit --project=mobile-safari",
    "e2e:a11y": "playwright test e2e/a11y.spec.ts --project=chromium",
    "e2e:visual": "playwright test --project=visual",
    "pages:build": "bash scripts/build-static-export.sh",
    "pages:deploy": "bash scripts/build-static-export.sh && wrangler pages deploy out --project-name=personal-learning-platform --branch=main",
    "pages:deploy:preview": "bash scripts/build-static-export.sh && wrangler pages deploy out --project-name=personal-learning-platform",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@mdx-js/mdx": "^3.1.1",
    "@plp/content": "workspace:*",
    "@plp/domain": "workspace:*",
    "@plp/graph": "workspace:*",
    "@plp/visualizations": "workspace:*",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@xyflow/react": "^12.11.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.38.0",
    "next": "^16.3.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "web-worker": "^1.5.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@opennextjs/cloudflare": "^1.20.5",
    "@playwright/test": "^1.55.0",
    "@plp/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "happy-dom": "^20.13.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.3.7",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.127.1"
  }
}
